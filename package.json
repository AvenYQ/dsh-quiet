{
  "name": "dsh-quiet",
  "version": "0.3.0",
  "description": "Quiet dot-matrix backdrop with a swimming DeepSeek whale, plus blur-to-clear streaming text for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "canvas",
    "whale",
    "typewriter",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvenYQ/dsh-quiet.git"
  },
  "homepage": "https://github.com/AvenYQ/dsh-quiet#readme",
  "bugs": {
    "url": "https://github.com/AvenYQ/dsh-quiet/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
